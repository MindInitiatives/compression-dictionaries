# First visit: the browser advertises dictionary encodings, and the server
# marks the response as the dictionary for future matching requests.

GET /assets/app-28e3bd80.js HTTP/2
Accept-Encoding: gzip, br, zstd, dcb, dcz

HTTP/2 200
Content-Encoding: br
Use-As-Dictionary: match="/assets/app-*.js"
Cache-Control: public, max-age=31536000, immutable
Vary: Accept-Encoding, Available-Dictionary
